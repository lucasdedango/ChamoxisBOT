DISCORD_TOKEN=your_discord_token_here

QBIT_URL=http://127.0.0.1:8080
QBIT_USER=admin
QBIT_PASS=your_qbittorrent_password

# optionnel
PLEX_URL=http://127.0.0.1:32400
PLEX_TOKEN=xxxx
PLEX_MOVIES_SECTION_ID=1
PLEX_SERIES_SECTION_ID=2

# Backend Torznab: prowlarr (recommandé) ou jackett
TORZNAB_BACKEND=prowlarr

# Prowlarr (recommandé)
PROWLARR_URL=http://127.0.0.1:9696
PROWLARR_API_KEY=your_prowlarr_api_key
PROWLARR_INDEXER_ID=1

# Jackett (fallback)
JACKETT_URL=http://127.0.0.1:9117
JACKETT_API_KEY=your_jackett_api_key
JACKETT_INDEXER=c411

# Optionnel: override complet d'un flux RSS Torznab
JACKETT_RSS_URL=
JACKETT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0 Safari/537.36
JACKETT_USER=
JACKETT_PASSWORD=
JACKETT_COOKIE_NAME=
JACKETT_COOKIE_VALUE=

# Journalisation
BOT_LOG_FILE=bot.log
BOT_LOG_LEVEL=INFO

# Force l'upload .torrent via le bot
JACKETT_FORCE_UPLOAD=false
