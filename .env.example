DISCORD_TOKEN=your_discord_token_here

QBIT_URL=http://127.0.0.1:8080
QBIT_USER=admin
QBIT_PASS=your_qbittorrent_password

# optionnel
PLEX_URL=http://127.0.0.1:32400
PLEX_TOKEN=xxxx
PLEX_MOVIES_SECTION_ID=1
PLEX_SERIES_SECTION_ID=2

# Jackett (RSS)
JACKETT_URL=http://127.0.0.1:9117
JACKETT_API_KEY=your_jackett_api_key
# Optionnel : override d'un flux précis (sinon construit depuis URL/API key)
JACKETT_RSS_URL=
JACKETT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0 Safari/537.36
JACKETT_USER=
JACKETT_PASSWORD=
JACKETT_COOKIE_NAME=
JACKETT_COOKIE_VALUE=
# Si Jackett est protégé par login ou cookie, remplis JACKETT_USER/JACKETT_PASSWORD (Basic Auth)
# et/ou JACKETT_COOKIE_NAME/JACKETT_COOKIE_VALUE (cookie Jackett). Le bot tentera d'abord sans auth,
# puis avec ces valeurs si un 302/401/403 est rencontré.
