# Copy to manager/.env and set MANAGER_ENV_FILE=manager/.env.
# Generate independent random keys; never commit actual values.
MANAGER_API_KEY=
MANAGER_ADMIN_API_KEY=
PLEX_MODULE_API_KEY=
MANAGER_HOST=127.0.0.1
MANAGER_PORT=8760
MANAGER_URL=http://127.0.0.1:8760
PLEX_MODULE_URL=http://127.0.0.1:8761
# Inherited by a module process explicitly started by the supervisor.
PLEX_ENV_FILE=modules/plex/.env
MANAGER_DATA_DIR=data/manager
SERVICES_CONFIG=config/services.json

DISCORD_TOKEN=
DISCORD_GUILD_ID=369545955252502528
# Empty user list permits server users; admin list is deny-by-default.
DISCORD_ALLOWED_USER_IDS=
DISCORD_ADMIN_IDS=
# Notifications can only be sent to these explicit channel IDs.
DISCORD_NOTIFICATION_CHANNEL_IDS=
ALERT_CHANNEL_ID=

OLLAMA_LOCAL_URL=http://127.0.0.1:11434
OLLAMA_LOCAL_MODEL=qwen3:4b
OLLAMA_REMOTE_URL=
OLLAMA_REMOTE_MODEL=qwen3:14b
OLLAMA_CONTEXT=4096
