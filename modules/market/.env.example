# Separate Discord application: NEVER reuse the Plex bot token here.
MARKET_DISCORD_TOKEN=
MARKET_CHANNEL_ID=
MARKET_GUILD_ID=
# At least one Market admin is required. No relationship with DISCORD_ADMIN_IDS.
MARKET_ADMIN_IDS=
# Empty means admins only. /admin utilisateurs ajouter grants persistent access.
MARKET_ALLOWED_USER_IDS=
MARKET_DATA_DIR=data/market
MARKET_HEALTH_PORT=8762
