# Copy to modules/plex/.env and set PLEX_ENV_FILE=modules/plex/.env.
# Match the module key in manager configuration; MANAGER_API_KEY is the
# module/event key, never the administrative manager key.
PLEX_MODULE_API_KEY=
MANAGER_API_KEY=
MANAGER_URL=http://127.0.0.1:8760
PLEX_MODULE_HOST=127.0.0.1
PLEX_MODULE_PORT=8761
PLEX_DATA_DIR=data/plex

QBIT_URL=http://127.0.0.1:8080
QBIT_USER=
QBIT_PASS=
PROWLARR_URL=http://127.0.0.1:9696
PROWLARR_API_KEY=
PROWLARR_INDEXER_ID=1
PROWLARR_INDEXER_IDS=1,2
PROWLARR_INDEXER_LABELS=1:C411,2:torr9
# Optional override; omit entirely to use the generated default feed URL.
# TORZNAB_RSS_URL=
TORZNAB_FORCE_UPLOAD=false
DISABLE_TORRENT_DOWNLOAD=true

PLEX_MOVIES_PATHS=D:\plexmediaserver\movies|E:\plexmediaserver\movies
PLEX_SERIES_PATHS=D:\plexmediaserver\series|E:\plexmediaserver\series
STORAGE_PICK_MODE=weighted_random
MIN_FREE_GB=30
PLEX_URL=http://127.0.0.1:32400
PLEX_TOKEN=
PLEX_MOVIES_SECTION_ID=1
PLEX_SERIES_SECTION_ID=2
